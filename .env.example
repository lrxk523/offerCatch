# LLM 提供商选择 (siliconflow | deepseek | zhipu | moonshot | qwen | doubao)
# 留空则使用下方 OPENAI_BASE_URL 自定义配置
LLM_PROVIDER=siliconflow

# 硅基流动 (SiliconFlow) API 配置
# 注册获取 API Key: https://cloud.siliconflow.cn
OPENAI_API_KEY=your-siliconflow-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 简历优化专用模型（需输出复杂 JSON，7B 不够用）
# RESUME_MODEL=Qwen/Qwen2.5-72B-Instruct

# JD 结构化抽取专用模型（原正则解析已废弃，JD 文本/匹配走此模型抽取）
# JD_MODEL=

# ---- 视觉模型配置（JD 图片直读 / PDF 扫描件转录 / 简历图片识别）----
# 优先级: VISION_* 独立变量 > LLM_PROVIDER 预设的 vision_model
# VISION_MODEL=none 可显式禁用视觉能力(回落本地 OCR)
# VISION_API_KEY=your-vision-key
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen3.5-omni-flash   # ⚠️ 必须用小写 API ID（显示名 "Qwen3.5-Omni-Flash" 不能用于 API）
#
# 例: 文本对话走 DeepSeek + 图片识别走千问 Omni（双平台分工）:
#   LLM_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=sk-...
#   VISION_API_KEY=sk-...            # DashScope 的 key
#   VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   VISION_MODEL=qwen3.5-omni-flash

# ---- 其他提供商 (取消注释并填入 API Key) ----

# DeepSeek (延迟低，性价比高)
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...

# 智谱 GLM-4 (中文理解强)
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-zhipu-key

# Moonshot Kimi (长上下文)
# LLM_PROVIDER=moonshot
# MOONSHOT_API_KEY=your-moonshot-key

# 通义千问 (阿里云)
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=your-dashscope-key

# ---- OCR 引擎设置 ----
# OCR_ENGINE=auto   # auto(默认): 配了 VISION_* 走云转录，否则本地 PaddleOCR
# OCR_ENGINE=qwen_vl  # 强制云转录（需配 VISION_*）
# OCR_ENGINE=paddle   # 强制本地 OCR
# OCR_GPU=auto      # 本地 OCR GPU 设置 (auto/true/false)

# ---- Redis 配置 ----
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
