# LLM 提供商选择 (siliconflow | deepseek | zhipu | moonshot | qwen | doubao)
# 留空则使用下方 OPENAI_BASE_URL 自定义配置
LLM_PROVIDER=siliconflow

# 硅基流动 (SiliconFlow) API 配置
# 注册获取 API Key: https://cloud.siliconflow.cn
OPENAI_API_KEY=your-siliconflow-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 简历优化专用模型（需输出复杂 JSON，7B 不够用）
# RESUME_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---- 其他提供商 (取消注释并填入 API Key) ----

# DeepSeek (延迟低，性价比高)
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# 智谱 GLM-4 (中文理解强)
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-zhipu-key

# Moonshot Kimi (长上下文)
# LLM_PROVIDER=moonshot
# MOONSHOT_API_KEY=your-moonshot-key

# 通义千问 (阿里云)
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=your-dashscope-key

# ---- OCR 引擎 GPU 设置 ----
# OCR_GPU=auto    # 自动检测 (默认)
# OCR_GPU=true    # 强制 GPU
# OCR_GPU=false   # 强制 CPU

# ---- Redis 配置 ----
# REDIS_HOST=10.220.240.245
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
